{
  "name": "inventory-management-system",
  "version": "1.0.0",
  "description": "A modern inventory management system",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "react-scripts start",
    "build": "react-scripts build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "jest --projects",
    "test:frontend": "jest --projects --selectProjects Frontend",
    "test:backend": "jest --projects --selectProjects Backend",
    "test:watch": "jest --projects --watch",
    "test:coverage": "jest --projects --coverage",
    "test:coverage:frontend": "jest --projects --selectProjects Frontend --coverage",
    "test:coverage:backend": "jest --projects --selectProjects Backend --coverage",
    "eject": "react-scripts eject",
    "agile:init": "node .kiro/agile/scripts/init-sprint.js",
    "agile:start-sprint": "node .kiro/agile/scripts/start-sprint.js",
    "agile:end-sprint": "node .kiro/agile/scripts/end-sprint.js",
    "agile:add-story": "node .kiro/agile/scripts/add-story.js",
    "agile:update-story": "node .kiro/agile/scripts/update-story.js",
    "agile:burndown": "node .kiro/agile/scripts/generate-burndown.js",
    "agile:report": "node .kiro/agile/scripts/generate-report.js",
    "agile:setup-hooks": "node .kiro/agile/scripts/setup-git-hooks.js",
    "agile:verify": "node .kiro/agile/scripts/verify-setup.js",
    "test:unit": "jest --projects --testPathPattern='__tests__' --coverage",
    "test:unit:watch": "jest --projects --testPathPattern='__tests__' --watch",
    "test:integration": "jest --projects --testPathPattern='integration' --runInBand",
    "test:integration:watch": "jest --projects --testPathPattern='integration' --runInBand --watch",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:firefox": "cypress run --browser firefox",
    "test:e2e:performance": "cypress run --spec 'cypress/e2e/performance.cy.js'",
    "test:e2e:workflow": "cypress run --spec 'cypress/e2e/agile-workflow.cy.js'",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "lint": "eslint src/ server/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ server/ --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" \"server/**/*.{js,md}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\" \"server/**/*.{js,md}\" \"*.{js,json,md}\"",
    "git:setup": "node scripts/setup-git-workflow.js",
    "git:create-branch": "node scripts/create-story-branch.js",
    "git:install-hooks": "git config core.hooksPath .githooks",
    "quality:gate": "node scripts/quality-gate.js",
    "quality:checklist": "node scripts/generate-review-checklist.js",
    "quality:metrics": "node scripts/collect-metrics.js",
    "story:update": "node scripts/update-story-status.js",
    "migrate": "node scripts/migrate-database.js up",
    "migrate:rollback": "node scripts/migrate-database.js rollback",
    "migrate:status": "node scripts/migrate-database.js status",
    "migrate:test": "NODE_ENV=test node scripts/migrate-database.js up",
    "performance:test": "node scripts/performance-test.js",
    "ci:full": "npm run lint && npm run format:check && npm run test:all && npm run build",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "optimize": "npm run lint:fix && npm run format && npm run build:analyze"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.5",
    "@mui/material": "^5.14.5",
    "@mui/x-date-pickers": "^6.10.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.3.3",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "formik": "^2.4.3",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "lucide-react": "^0.539.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "react-scripts": "5.0.1",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cypress": "^14.5.4",
    "cypress-axe": "^1.6.0",
    "cypress-real-events": "^1.14.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.5.1",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
