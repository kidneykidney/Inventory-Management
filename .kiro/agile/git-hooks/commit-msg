#!/bin/sh
# Commit message hook for Agile development workflow

commit_regex='^(feat|fix|docs|style|refactor|test|chore)(\(story-[0-9]+\))?: .{1,50}'

if ! grep -qE "$commit_regex" "$1"; then
    echo "❌ Invalid commit message format!"
    echo ""
    echo "Commit message should follow the format:"
    echo "  type(story-XXX): description"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, test, chore"
    echo "Example: feat(story-001): add user authentication"
    echo "Example: fix(story-002): resolve login validation bug"
    echo ""
    exit 1
fi

echo "✅ Commit message format is valid"
exit 0